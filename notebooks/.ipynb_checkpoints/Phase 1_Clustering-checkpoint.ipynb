    "## 9. GÁN NHÃN PHÂN KHÚC"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 58,
   "id": "ceb37b89-e92f-49da-8b3d-44da8defa8df",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Segment\n",
      "The High-Potential    1770\n",
      "Need Attention        1720\n",
      "The Elite              824\n",
      "Name: count, dtype: int64\n"
     ]
    }
   ],
   "source": [
    "def assign_segment(cluster_id):\n",
    "    sorted_clusters = cluster_summary_scaled.sort_values('Monetary', ascending=False).index.tolist()\n",
    "    \n",
    "    if cluster_id == sorted_clusters[0]:\n",
    "        return 'The Elite'\n",
    "    elif cluster_id == sorted_clusters[-1]:\n",
    "        return 'Need Attention'\n",
    "    else:\n",
    "        if cluster_summary_scaled.loc[cluster_id, 'Recency'] < cluster_summary_scaled['Recency'].median():\n",
    "            return 'The Loyalists'\n",
    "        else:\n",
    "            return 'The High-Potential'\n",
    "\n",
    "customer['Segment'] = customer['Cluster'].apply(assign_segment)\n",
    "\n",
    "# Kiểm tra\n",
    "print(customer['Segment'].value_counts())"
   ]
  },
